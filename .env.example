NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
FIXTURE_SERVER_BASE_URL=http://localhost:4001
FIXTURE_RECEIVER_BASE_URL=http://localhost:4002

DATABASE_URL=postgres://threatlens:threatlens@localhost:5432/threatlens
SESSION_SECRET=replace-with-local-random-value

# Optional app runtime provider. Separate from Antigravity's coding-agent model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local lab only. Configured server-side, never accepted from client scan requests.
FIXTURE_MODE_ENABLED=true
FIXTURE_ALLOWED_HOSTS=fixture.threatlens.test,receiver.threatlens.test,localhost,127.0.0.1
FIXTURE_SCOPE_TTL_SECONDS=900

# Set only when a real controlled egress boundary exists.
PUBLIC_FETCH_ENABLED=false
EGRESS_PROXY_URL=

ARTIFACT_RETENTION_DAYS=7
CASE_RETENTION_DAYS=30
ANALYSIS_TIMEOUT_SECONDS=60
